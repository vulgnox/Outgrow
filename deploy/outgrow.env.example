# /etc/outgrow.env  (installed by install.sh; edit with: sudo nano /etc/outgrow.env, then: sudo systemctl restart outgrow)
PORT=8765
# Only listen on this machine. The HTTPS tunnel/proxy connects to it locally. Never expose this port directly.
OUTGROW_BIND=127.0.0.1
# App usernames (comma separated) that get the Server dashboard: live stats, DB backup download, PIN resets.
OUTGROW_ADMINS=vulgnox
# The streak 'day' rolls over at 3 AM in THIS timezone. IST without needing tzdata installed.
TZ=IST-5:30
# Optional: post badges / level-ups / streaks to a Discord channel.
# OUTGROW_DISCORD_WEBHOOK=
