[Unit]
Description=OUTGROW crew growth tracker
After=network-online.target
Wants=network-online.target

[Service]
User=outgrow
Group=outgrow
WorkingDirectory=/opt/outgrow/app
EnvironmentFile=/etc/outgrow.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/outgrow/app/server.py
Restart=always
RestartSec=3
# Be a good guest on a shared VPS
MemoryMax=400M
CPUQuota=70%
TasksMax=256
# Sandbox: the app can only write to its own data folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/outgrow/app/data

[Install]
WantedBy=multi-user.target
