[Unit]
Description=RAGDAMAXING crew growth tracker
After=network-online.target
Wants=network-online.target

[Service]
User=ragdamaxing
Group=ragdamaxing
WorkingDirectory=/opt/ragdamaxing/app
EnvironmentFile=/etc/ragdamaxing.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ragdamaxing/app/server.py
Restart=always
RestartSec=3
# Be a good guest on a shared VPS
MemoryMax=400M
CPUQuota=70%
TasksMax=256
# Sandbox: the app can only write to its own data folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/ragdamaxing/app/data

[Install]
WantedBy=multi-user.target
